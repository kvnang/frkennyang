{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frkennyang",
  "account_id": "7ea3718fc0fd423e23c700b0ee874b57",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "fatherkenny-origin.kevinang.com/*",
      "zone_name": "kevinang.com",
    },
  ],
  "keep_vars": true,
  "minify": true,
  "browser": {
    "binding": "BROWSER",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/en/cv/download/*", "/id/cv/download/*"],
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "frkennyang",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "2f9aa03d4d1742b88ca58dea9a7eccc0",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
      {
        "name": "CV_RENDERER",
        "class_name": "CvRenderer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CvRenderer"],
    },
  ],
  "vars": {
    "FORM_SUBMISSIONS_LIVE": "true",
  },
  // OpenNext's cache seeding command reads Wrangler environments. Target the
  // same KV namespace as the hosted Previews without writing to production KV.
  "env": {
    "preview-cache": {
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "8bbf0e5c577847d9ba21e8f89b7f96c0",
        },
      ],
    },
  },
  "previews": {
    "vars": {
      "FORM_SUBMISSIONS_LIVE": "false",
    },
    "browser": {
      "binding": "BROWSER",
    },
    "kv_namespaces": [
      {
        "binding": "NEXT_INC_CACHE_KV",
        "id": "8bbf0e5c577847d9ba21e8f89b7f96c0",
      },
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "NEXT_CACHE_DO_QUEUE",
          "class_name": "DOQueueHandler",
        },
        {
          "name": "NEXT_TAG_CACHE_DO_SHARDED",
          "class_name": "DOShardedTagCache",
        },
        {
          "name": "CV_RENDERER",
          "class_name": "CvRenderer",
        },
      ],
    },
  },
}
